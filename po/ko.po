#: src/hdmiosd.cpp:31
msgid ""
"Usage: hdmiosd [OPTION]...\n"
"Control HDMI/DP monitor settings via DDC/CI (Device OSD) and App OSD.\n"
"\n"
msgstr ""
"사용법: hdmiosd [옵션]...\n"
"DDC/CI로 HDMI/DP 모니터를 제어합니다(장치 OSD 및 앱 OSD).\n"
"\n"

#: src/hdmiosd.cpp:35
msgid "/dev/i2c-*, /dev/video*, PCI/USB id, or /sys/... path\n"
msgstr "/dev/i2c-*, /dev/video*, PCI/USB id 또는 /sys/... 경로\n"

#: src/hdmiosd.cpp:37
msgid "window opacity 0-100 (overrides settings.ini)\n"
msgstr "창 불투명도 0–100(settings.ini 덮어씀)\n"

#: src/hdmiosd.cpp:39
msgid "window size\n"
msgstr "창 크기\n"

#: src/hdmiosd.cpp:41
msgid "place from left edge\n"
msgstr "왼쪽 가장자리로부터 배치\n"

#: src/hdmiosd.cpp:43
msgid "place from right edge\n"
msgstr "오른쪽 가장자리로부터 배치\n"

#: src/hdmiosd.cpp:45
msgid "place from top edge\n"
msgstr "위쪽 가장자리로부터 배치\n"

#: src/hdmiosd.cpp:47
msgid "place from bottom edge\n"
msgstr "아래쪽 가장자리로부터 배치\n"

#: src/hdmiosd.cpp:49
msgid "list DDC-capable displays and exit\n"
msgstr "DDC 지원 디스플레이 목록 출력 후 종료\n"

#: src/hdmiosd.cpp:51
msgid "more logging\n"
