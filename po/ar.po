#: src/hdmiosd.cpp:31
msgid ""
"Usage: hdmiosd [OPTION]...\n"
"Control HDMI/DP monitor settings via DDC/CI (Device OSD) and App OSD.\n"
"\n"
msgstr ""
"الاستخدام: hdmiosd [خيار]...\n"
"التحكم في شاشات HDMI/DP عبر DDC/CI (OSD الجهاز وOSD التطبيق).\n"
"\n"

#: src/hdmiosd.cpp:35
msgid "/dev/i2c-*, /dev/video*, PCI/USB id, or /sys/... path\n"
msgstr "/dev/i2c-* أو /dev/video* أو معرّف PCI/USB أو مسار /sys/...\n"

#: src/hdmiosd.cpp:37
msgid "window opacity 0-100 (overrides settings.ini)\n"
msgstr "شفافية النافذة 0–100 (يتجاوز settings.ini)\n"

#: src/hdmiosd.cpp:39
msgid "window size\n"
msgstr "حجم النافذة\n"

#: src/hdmiosd.cpp:41
msgid "place from left edge\n"
msgstr "الموضع من الحافة اليسرى\n"

#: src/hdmiosd.cpp:43
msgid "place from right edge\n"
msgstr "الموضع من الحافة اليمنى\n"

#: src/hdmiosd.cpp:45
msgid "place from top edge\n"
msgstr "الموضع من الحافة العلوية\n"

#: src/hdmiosd.cpp:47
msgid "place from bottom edge\n"
msgstr "الموضع من الحافة السفلية\n"

#: src/hdmiosd.cpp:49
msgid "list DDC-capable displays and exit\n"
msgstr "سرد الشاشات التي تدعم DDC ثم الخروج\n"

#: src/hdmiosd.cpp:51
msgid "more logging\n"
msgstr "المزيد من السجلات\n"

