#: src/hdmiosd.cpp:31
msgid ""
"Usage: hdmiosd [OPTION]...\n"
"Control HDMI/DP monitor settings via DDC/CI (Device OSD) and App OSD.\n"
"\n"
msgstr ""
"使い方: hdmiosd [オプション]...\n"
"DDC/CI で HDMI/DP モニタを制御します（デバイス OSD とアプリ OSD）。\n"
"\n"

#: src/hdmiosd.cpp:35
msgid "/dev/i2c-*, /dev/video*, PCI/USB id, or /sys/... path\n"
msgstr ""
"/dev/i2c-*、/dev/video*、PCI/USB ID、または /sys/... パス\n"

#: src/hdmiosd.cpp:37
msgid "window opacity 0-100 (overrides settings.ini)\n"
msgstr ""
"ウィンドウ不透明度 0–100（settings.ini を上書き）\n"

