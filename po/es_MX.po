#: src/hdmiosd.cpp:31
msgid ""
"Usage: hdmiosd [OPTION]...\n"
"Control HDMI/DP monitor settings via DDC/CI (Device OSD) and App OSD.\n"
"\n"
msgstr ""
"Uso: hdmiosd [OPCIÓN]...\n"
"Controla monitores HDMI/DP vía DDC/CI (OSD del dispositivo y OSD de la app).\n"
"\n"

