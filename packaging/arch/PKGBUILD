# stub — align with debian/control and Meson install
pkgname=hdmiosd
pkgver=0.0.0
pkgrel=1
pkgdesc="On-screen DDC/CI controller for HDMI/DP displays"
arch=('x86_64')
url="https://github.com/lenik/hdmiosd"
license=('AGPL-3.0-or-later')
depends=('wxwidgets-gtk3' 'bas-cpp' 'bas-ui')
makedepends=('meson' 'ninja' 'asciidoctor' 'pkgconf' 'zip' 'binutils' 'nlohmann-json' 'gettext')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/../.."
  zfr version 2>/dev/null | sed 's/^v//' || head -n1 VERSION
}

build() {
  cd "$startdir/../.."
  meson setup build-arch --prefix=/usr --buildtype=plain
  meson compile -C build-arch
}

package() {
  cd "$startdir/../.."
  DESTDIR="$pkgdir" meson install -C build-arch
}
